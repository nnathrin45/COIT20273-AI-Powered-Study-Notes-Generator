          "name": "Generate flashcards (FR10)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ai/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ai",
                "generate"
              ]
            },
            "description": "Returns 5-15 question/answer records as an array.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{fileId}}\",\n  \"output_type\": \"flashcards\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('content is an array of cards', () =>",
                  "  pm.expect(b.output.content).to.be.an('array'));",
                  "console.log('Cards generated:', b.output.content.length);"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate quiz (FR11.1) \u2014 captures quizOutputId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ai/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ai",
                "generate"
              ]
            },
            "description": "Returns 5-10 multiple-choice and true/false questions. Every `correct_answer` repeats one of that question's own options.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{fileId}}\",\n  \"output_type\": \"quiz\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "const qs = b.output.content;",
                  "pm.test('content is an array of questions', () =>",
                  "  pm.expect(qs).to.be.an('array'));",
                  "pm.test('every correct_answer is one of its own options', () => {",
                  "  qs.forEach(q => pm.expect(q.options).to.include(q.correct_answer));",
                  "});",
                  "pm.collectionVariables.set('quizOutputId', b.output.output_id);",
                  "// Build answer arrays sized to THIS quiz. A fixed-length array caused",
                  "// ANSWER_COUNT_MISMATCH when the quiz had more questions (reported by",
                  "// Member 1, 2 Sep 2026).",
                  "pm.collectionVariables.set('quizAnswers', JSON.stringify(qs.map(q => q.correct_answer)));",
                  "const partial = qs.map((q, i) => (i === 0 ? q.correct_answer : null));",
                  "pm.collectionVariables.set('quizAnswersPartial', JSON.stringify(partial));",
                  "console.log(`Quiz ${b.output.output_id}: ${qs.length} questions, answers prepared.`);"
                ]
              }
            }
          ]
        },
