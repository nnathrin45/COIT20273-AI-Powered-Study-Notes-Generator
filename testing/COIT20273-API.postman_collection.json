    {
      "name": "5. Error cases (evidence for Report 2) \u2014 Member 3",
      "description": "Each request here demonstrates a documented failure path. All errors share the shape `{ status, code, message }` \u2014 switch on `code`, not `message`. Retryable failures also carry `retryable: true` (NFR5).",
      "item": [
        {
          "name": "403 CONSENT_REQUIRED",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ai/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ai",
                "generate"
              ]
            },
            "description": "Proves FR17.1 and FR17.2: generation is refused when consent is not currently granted.\n\nThis request is **self-contained** \u2014 a pre-request script revokes consent first, and the test script restores it afterwards. It therefore passes regardless of run order and leaves the collection usable for a re-run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{fileId}}\",\n  \"output_type\": \"summary\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Revoke consent so this request tests what it claims to test.",
                  "// Without this the outcome depends on run order (found 3 Sep 2026).",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/consent',",
                  "  method: 'POST',",
                  "  header: {",
                  "    'Content-Type': 'application/json',",
                  "    'Authorization': 'Bearer ' + pm.collectionVariables.get('token')",
                  "  },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ status: 'revoked' }) }",
                  "}, (err) => { if (err) { console.error('Could not revoke consent:', err); } });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('code is CONSENT_REQUIRED', () =>",
                  "  pm.expect(pm.response.json().code).to.eql('CONSENT_REQUIRED'));",
                  "// Restore consent so the collection can be re-run without manual steps",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/consent',",
                  "  method: 'POST',",
                  "  header: {",
                  "    'Content-Type': 'application/json',",
                  "    'Authorization': 'Bearer ' + pm.collectionVariables.get('token')",
                  "  },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ status: 'granted' }) }",
                  "}, () => console.log('Consent restored.'));"
                ]
              }
            }
          ]
        },
